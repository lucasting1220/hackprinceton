{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "overrides": [{ "includes": ["contracts/vectors.json"], "formatter": { "enabled": false } }],
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!package-lock.json", "!.plans", "!debbie-ios"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": { "noVoid": "error" },
      "correctness": { "useImportExtensions": "error" },
      "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" },
      "style": { "useNodejsImportProtocol": "error" },
      "suspicious": { "noEmptyBlockStatements": "error", "noSkippedTests": "error" }
    }
  }
}
