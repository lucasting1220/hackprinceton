# coturn for Debbie (steps 0b and 7), matching the server's /etc/turnserver.conf. The shared secret
# is not here: RUNBOOK.md step 7 appends the static-auth-secret line on the server from
# /etc/debbie/turn-secret, which never leaves the server.
listening-port=3478
min-port=49160
max-port=49200
external-ip=144.202.5.15
realm=relay.144-202-5-15.sslip.io
use-auth-secret
fingerprint
no-cli
no-multicast-peers
no-tlsv1
no-tlsv1_1
stale-nonce=600
user-quota=12
total-quota=100
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
log-file=syslog
simple-log
