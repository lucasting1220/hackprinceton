#!/usr/bin/env bash
# Brief §3: before every commit, check the staged changes contain none of the ASC_KEY_ID,
# ASC_ISSUER_ID or ASC_KEY_PATH values or any .p8 content. Values are read from asc.env
# at run time and never printed.
set -uo pipefail
ENV_FILE="$HOME/.config/debbie-ios/asc.env"
staged="$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+' || true)"
fail=0
if printf '%s' "$staged" | grep -qE -- '-----BEGIN (EC |ENCRYPTED )?PRIVATE KEY-----'; then
  echo "pre-commit: staged changes contain private key material (.p8 content). Commit refused."; fail=1
fi
# Google API keys (Debbie's Gemini key, D-031) never enter the repo, whatever file they are in.
if printf '%s' "$staged" | grep -qE 'AIza[0-9A-Za-z_-]{35}'; then
  echo "pre-commit: staged changes contain a Google API key. Commit refused (value not shown)."; fail=1
fi
if git diff --cached --name-only | grep -qiE '\.(p8|p12|cer|mobileprovision|keychain-db)$|AuthKey_'; then
  echo "pre-commit: a signing or key file is staged. Commit refused."; fail=1
fi
if [[ -f "$ENV_FILE" ]]; then
  while IFS= read -r line; do
    line="${line#export }"
    key="${line%%=*}"; val="${line#*=}"; val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
    case "$key" in
      ASC_KEY_ID|ASC_ISSUER_ID|ASC_KEY_PATH)
        if [[ -n "$val" ]] && printf '%s' "$staged" | grep -qF -- "$val"; then
          echo "pre-commit: staged changes contain the value of $key. Commit refused (value not shown)."; fail=1
        fi
        # The .p8 itself is never opened (brief §3): the PEM-header and file-name checks above catch its content.
        ;;
    esac
  done < <(grep -E '^(export )?[A-Z_]+=' "$ENV_FILE")
fi
exit $fail
