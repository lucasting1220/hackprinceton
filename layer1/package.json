{
  "name": "debbie-layer1",
  "version": "0.1.0",
  "private": true,
  "description": "Debbie Layer 1: the bridge on every laptop, its setup page and the launcher for Layer 2's programs",
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=30000 \"**/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
