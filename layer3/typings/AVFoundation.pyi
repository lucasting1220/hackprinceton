"""Types for the parts of pyobjc's AVFoundation that Layer 3 uses. Installed on macOS only."""

AVMediaTypeVideo: str
AVMediaTypeAudio: str

class AVCaptureDevice:
    @staticmethod
    def devicesWithMediaType_(media_type: str) -> list[AVCaptureDevice]: ...
    @staticmethod
    def authorizationStatusForMediaType_(media_type: str) -> int: ...
    def localizedName(self) -> str: ...
    def deviceType(self) -> str: ...
    def transportType(self) -> int: ...
